// Esquema de Konnect — Postgres (Neon).
// Refleja los tipos de `lib/types.ts`; `lib/store.ts` es la única capa que lo consulta.
// Los campos bancarios se guardan cifrados (AES-256-GCM) mediante lib/crypto.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CreatorStatus {
  activo
  pausado
  prospecto
  archivado
}

enum CompanyStatus {
  activo
  prospecto
  inactivo
}

/// Quién contrata: una empresa o una persona que factura a su nombre.
enum CompanyKind {
  empresa
  /// Persona natural: no es una empresa, pero contrata igual y tiene sus
  /// propios contactos —su asistente, su mánager—. Antes había que darla de
  /// alta como empresa inventándole un sector.
  persona
}

/// `finalizada` es que se cumplió; `cancelada`, que se cayó. Las dos cierran la
/// campaña, pero mezclarlas falsea los informes: lo cancelado no se facturó.
enum CampaignStatus {
  borrador
  activa
  pausada
  finalizada
  cancelada
}

enum CampaignObjective {
  awareness
  trafico
  conversiones
  lanzamiento
}

/// Qué se le encarga al creador. El nombre que ve el equipo depende también de
/// la red: un `short` es un Reel en Instagram y un Short en YouTube.
enum DeliverableType {
  video
  short
  integracion
  /// Emisión en vivo: stream patrocinado o mención durante el directo.
  directo
  /// Publicación estática: carrusel, foto o hilo.
  post
}

enum DeliverableStatus {
  pendiente
  en_revision
  publicado
  cancelado
}

/// Estado del pago de una pieza. Lo ve la agencia y también el creador.
enum PaymentStatus {
  pendiente
  aprobado
  pagado
}

enum PaymentMethod {
  transferencia
  paypal
  wise
  binance
  deel
  efectivo
}

enum SocialPlatform {
  youtube
  instagram
  tiktok
  x
  twitch
  kick
  discord
  roblox
  web
}

model Creator {
  id     String @id
  name   String
  handle String

  /// Dónde vive principalmente. No todos los creadores son de YouTube.
  mainPlatform SocialPlatform @default(youtube)

  /// Solo para canales de YouTube; vacío en el resto de plataformas.
  channelId  String?
  channelUrl String?
  avatarUrl  String?
  country    String        @default("")
  /// La categoría principal: la primera de `categories`. Se mantiene aparte
  /// porque agrupa la lista de creadores y la usan los informes de antes.
  category   String
  /// Todas sus categorías. Un creador de Roblox es también de Gaming, y con
  /// una sola había que elegir y la otra se perdía al cambiarla. Vacía en las
  /// fichas de antes: se lee como `[category]`.
  categories String[]      @default([])
  status     CreatorStatus @default(prospecto)

  email String @default("")
  phone String @default("")

  // Métricas públicas del canal (YouTube Data API)
  subscribers      Int       @default(0)
  totalViews       BigInt    @default(0)
  videoCount       Int       @default(0)
  metricsUpdatedAt DateTime?

  currency        String          @default("USD")
  rateVideo       Decimal         @default(0) @db.Decimal(12, 2)
  rateShort       Decimal         @default(0) @db.Decimal(12, 2)
  rateIntegration Decimal         @default(0) @db.Decimal(12, 2)
  paymentMethods  PaymentMethod[]

  // Confidencial: cifrado en reposo. Los *Last4 permiten la vista censurada.
  bankHolder       String?
  bankName         String?
  bankAccountEnc   String?
  bankAccountLast4 String?
  bankRoutingEnc   String?
  bankRoutingLast4 String?
  taxIdEnc         String?
  taxIdLast4       String?
  paypalEmailEnc   String?
  bankNotesEnc     String?

  // Datos personales, cifrados como los bancarios y detrás del mismo código:
  // el nombre legal y la dirección hacen falta para facturar y enviar
  // productos, y son justo lo que no debe verse al pasar por la ficha.
  realNameEnc String?
  addressEnc  String?

  notes String @default("")

  rates          CreatorRate[]
  endedContracts CampaignCreatorEnd[]
  contacts       CreatorContact[]
  contactFields  CreatorContactField[]
  bankAccounts   CreatorBankAccount[]
  channels       CreatorChannel[]
  socials        SocialLink[]
  deliverables   Deliverable[]
  accessLogs     SensitiveAccessLog[]
  sessions       CollabSession[]
  apiConnections CreatorApiConnection[]
  campaignLeads  CampaignCreatorLead[]
  agency         CreatorAgency?
  statShots      CreatorStatShot[]
  packages       CreatorPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

/// Persona con la que se habla de un creador: él mismo, su mánager, su agencia.
/// Aparte de `Contact`, que cuelga de una empresa.
model CreatorContact {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  name    String
  /// Mánager, representante, editor… quién es respecto al creador.
  role    String  @default("")
  email   String  @default("")
  phone   String  @default("")
  /// El principal es con quien se habla por defecto.
  primary Boolean @default(false)
  notes   String  @default("")

  createdAt DateTime @default(now())

  @@index([creatorId])
}

/// Dato de contacto que no cabe en los campos fijos de la ficha: Discord,
/// Telegram, el correo del mánager… La agencia le pone el nombre que quiera.
///
/// Es una tabla y no una columna porque cada creador usa unos distintos y la
/// lista crece: fijar columnas obligaría a migrar cada vez que aparece una red
/// nueva por la que se le escribe.
model CreatorContactField {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  /// Cómo lo llama la agencia: "Discord", "Telegram", "Correo del mánager".
  label    String
  value    String @default("")
  /// Orden en la ficha, tal y como lo dejó quien editó.
  position Int    @default(0)

  createdAt DateTime @default(now())

  @@index([creatorId])
}

/// Una forma concreta de pagarle a un creador: su cuenta de banco, su PayPal,
/// su Binance… Un creador puede tener varias y cobrar por la que convenga.
///
/// Los campos que sirven para mover dinero van cifrados igual que los de la
/// ficha; los `*Last4` permiten la vista censurada sin descifrar nada.
model CreatorBankAccount {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  method   PaymentMethod
  /// Cómo la llama la agencia: "Bancolombia principal", "PayPal personal".
  label    String        @default("")
  holder   String        @default("")
  /// Solo tiene sentido en transferencia.
  bankName String        @default("")

  /// Lo que hace falta para pagar: número de cuenta, correo o billetera.
  referenceEnc   String?
  referenceLast4 String?
  /// SWIFT, routing o red de la billetera.
  routingEnc     String?
  routingLast4   String?
  notesEnc       String?

  /// La cuenta es de la agencia que representa al creador, no suya: cuando
  /// hay agencia de por medio, el pago va a ella.
  forAgency Boolean @default(false)

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}

/// Canal adicional de un creador: secundario, de shorts, de clips…
model CreatorChannel {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  label      String
  channelId  String
  channelUrl String
  handle     String
  avatarUrl  String?

  subscribers      Int       @default(0)
  totalViews       BigInt    @default(0)
  videoCount       Int       @default(0)
  metricsUpdatedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([creatorId, channelId])
  @@index([creatorId])
}

/// Perfil del creador en una plataforma, con sus propias métricas.
model SocialLink {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  handle   String
  url      String

  avatarUrl String?

  /// Seguidores, suscriptores o como los llame cada plataforma.
  followers        Int       @default(0)
  totalViews       BigInt    @default(0)
  contentCount     Int       @default(0)
  metricsUpdatedAt DateTime?

  createdAt DateTime @default(now())

  @@index([creatorId])
}

/// Credencial del creador para leer SU PROPIA analítica en cada plataforma
/// (YouTube Analytics API y, más adelante, Instagram y TikTok).
///
/// El secreto se guarda cifrado en reposo (AES-256-GCM, lib/crypto.ts) y nunca
/// se devuelve al cliente: la ficha sólo muestra los últimos 4 caracteres.
/// Por ahora la única plataforma funcional es `youtube`; el modelo ya admite el
/// resto para no volver a migrar cuando se activen.
/// Agencia externa que representa al creador.
///
/// Tabla aparte y uno a uno: la mayoría de creadores no tiene agencia, y los
/// que la tienen necesitan todo un contacto —con quién se negocia y a quién se
/// paga—, no un nombre suelto en las notas. Las cuentas de cobro de la agencia
/// viven con las del creador, marcadas con `forAgency`, para que sigan cifradas
/// y detrás del mismo código.
model CreatorAgency {
  creatorId String  @id
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  name        String
  /// Si el creador solo trabaja a través de ella.
  exclusive   Boolean @default(true)
  contactName String  @default("")
  email       String  @default("")
  phone       String  @default("")
  website     String  @default("")
  notes       String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Captura de las estadísticas del creador, subida a mano.
///
/// Es la alternativa cuando el creador no cede acceso a su API: se le piden
/// pantallazos de su panel —alcance, audiencia por país, edades— y se guardan
/// aquí, fechados, para poder enseñarlos y compararlos con los de meses atrás.
model CreatorStatShot {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  url        String
  fileName   String          @default("")
  platform   SocialPlatform?
  caption    String          @default("")
  /// De cuándo son los datos de la captura, que no es cuándo se subió.
  takenAt    DateTime?
  uploadedBy String          @default("")

  createdAt DateTime @default(now())

  @@index([creatorId, createdAt])
}

/// Paquete predeterminado del creador: varias piezas por un precio cerrado.
///
/// `items` es JSON y no una tabla: el paquete se lee y se escribe siempre
/// entero, y al contratarlo se copia en piezas normales de la campaña, así que
/// nada consulta su contenido por separado.
model CreatorPackage {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  name     String
  /// Lo que recibe el creador por el paquete entero, en su moneda.
  price    Decimal @default(0) @db.Decimal(12, 2)
  /// [{ platform, type, customType, qty }]
  items    Json
  notes    String  @default("")
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}

model CreatorApiConnection {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform    SocialPlatform
  secretEnc   String
  secretLast4 String         @default("")
  /// Id externo asociado a la credencial (channelId de YouTube, etc.).
  externalId  String         @default("")
  status      String         @default("conectada")

  connectedAt DateTime  @default(now())
  checkedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, platform])
  @@index([creatorId])
}

model Company {
  id       String      @id
  kind     CompanyKind @default(empresa)
  name     String
  industry String
  website  String?

  // Atajo al contacto principal; se mantiene sincronizado con `contacts`.
  contactName String @default("")
  contactRole String @default("")
  email       String @default("")
  phone       String @default("")

  instagram String?
  tiktok    String?
  youtube   String?
  linkedin  String?

  status CompanyStatus @default(prospecto)
  notes  String        @default("")

  contacts      Contact[]
  contactFields CompanyContactField[]
  campaigns     Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Persona de contacto en una empresa. Puede haber varias.
model Contact {
  id        String  @id
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name    String
  role    String  @default("")
  email   String  @default("")
  phone   String  @default("")
  primary Boolean @default(false)
  notes   String  @default("")

  createdAt DateTime @default(now())

  @@index([companyId])
}

model Campaign {
  id        String            @id
  name      String
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status    CampaignStatus    @default(borrador)
  objective CampaignObjective @default(awareness)
  currency  String            @default("USD")
  /// Opcional, al estilo CBO: si se define, es un tope de referencia. El precio
  /// real de la campaña es la suma de lo pactado con cada creador (ABO).
  budget    Decimal?          @db.Decimal(12, 2)
  /// Margen por defecto de la agencia, en % sobre el pago al creador.
  agencyFee Decimal?          @db.Decimal(5, 2)
  startDate DateTime
  endDate   DateTime?
  notes     String            @default("")

  /// La nota de Notas que hace de apuntes de la campaña. Null hasta que alguien
  /// escribe el primero; entonces se crea, enlazada a la campaña y con lo que
  /// hubiera en `notes` dentro.
  ///
  /// Una nota y no un campo de texto porque los apuntes crecen —acuerdos con
  /// el cliente, cambios de guion, capturas— y en Notas tienen editor, imágenes
  /// y búsqueda.
  ///
  /// Texto y no relación: una relación uno a uno exige índice único, y añadir
  /// uno sobre una tabla con datos pide confirmar posible pérdida en
  /// producción. Que no se creen dos notas lo garantiza la escritura
  /// condicionada de `ensureCampaignNotesDoc`, y si la nota se borra, la
  /// siguiente vez se crea otra.
  notesDocId String?

  /// Quién lleva la campaña. Es una persona, no un equipo: cuando el cliente
  /// pregunta hay que saber a quién se le pregunta.
  managerId String?
  manager   User?   @relation("CampaignManager", fields: [managerId], references: [id], onDelete: SetNull)

  /// Quién la dio de alta. No es lo mismo que quién la lleva: la crea a menudo
  /// quien cierra el trato y la lleva otro. Null en las campañas anteriores a
  /// que se guardara, y si la cuenta se borra.
  createdById String?
  createdBy   User?   @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  deliverables       Deliverable[]
  sessions           CollabSession[]
  /// Lo que se manda a todas sus sesiones a la vez, desde la sesión maestra.
  masterRequirements CampaignRequirement[]
  masterMaterials    CampaignMaterial[]
  /// Lo que el cliente ha pagado de la campaña, cobro a cobro.
  clientPayments     CampaignPayment[]
  members            CampaignMember[]
  endedContracts     CampaignCreatorEnd[]
  creatorLeads       CampaignCreatorLead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@index([managerId])
}

/// Contrato terminado con un creador dentro de una campaña.
///
/// Solo existe la fila cuando el contrato se da por cerrado: sin fila, el
/// creador sigue activo. Así no hay dos sitios que mantener sincronizados —la
/// participación se sigue deduciendo de sus entregables— y reabrir es borrar
/// la fila.
///
/// Cerrar un contrato NO borra nada. Las piezas ya entregadas o pagadas se
/// quedan como están, con su dinero: es trabajo que se hizo y se facturó.
/// Solo las que seguían pendientes se cancelan, porque ya no van a pasar.
model CampaignCreatorEnd {
  id         String   @id
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  endedAt DateTime @default(now())
  /// Por qué se cerró. Sale en la ficha y en la bitácora.
  reason  String   @default("")

  createdAt DateTime @default(now())

  @@unique([campaignId, creatorId])
  @@index([campaignId])
}

/// Empleado asignado a una campaña.
///
/// Solo importa para las cuentas con el permiso `solo_campanas_asignadas`: sin
/// él la asignación es informativa —quién anda en qué— y todo el mundo sigue
/// viendo todas las campañas, como siempre. Se hizo así para que activar esto
/// no le quite el acceso a nadie de golpe.
model CampaignMember {
  id         String   @id
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
}

model Deliverable {
  id         String            @id
  campaignId String
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    Creator           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  type       DeliverableType
  status     DeliverableStatus @default(pendiente)

  /// Nombre propio de la pieza cuando el encargo no es ninguno de los de
  /// fábrica: «Unboxing», «Podcast», «Mención en la newsletter». Vacío = se
  /// llama como la tarea estándar de su red.
  ///
  /// Es texto y no una relación al catálogo a propósito: borrar un tipo desde
  /// Configuración no puede renombrar ni vaciar piezas ya pactadas, igual que
  /// pasa con la categoría del creador.
  customType String @default("")

  /// Red social en la que se publica. Determina qué tarifa del creador aplica.
  platform SocialPlatform @default(youtube)

  /// Canal secundario en el que se publica, si se pactó uno concreto. Vacío =
  /// su canal principal. Elige qué tarifa del creador se aplicó.
  channelId String @default("")

  /// Lo que paga el cliente por esta pieza. Es el número base del que salen
  /// la comisión de la agencia y el pago al creador.
  clientPrice Decimal @default(0) @db.Decimal(12, 2)

  /// Comisión de la agencia, en % del cobro al cliente. Null = hereda el de la
  /// campaña. Se ignora si hay comisión fija.
  commissionPct   Decimal? @db.Decimal(5, 2)
  /// Comisión en cantidad fija, cuando no se pacta por porcentaje.
  commissionFixed Decimal? @db.Decimal(12, 2)

  /// Lo que recibe el creador: cobro al cliente menos comisión. Se guarda ya
  /// calculado para que los informes no dependan de rehacer la cuenta.
  agreedFee Decimal @default(0) @db.Decimal(12, 2)

  paymentStatus PaymentStatus @default(pendiente)
  paidAt        DateTime?

  /// Comprobante del pago al creador: la transferencia, el recibo de PayPal…
  /// Vive en Vercel Blob; aquí solo el enlace y con qué nombre se subió.
  receiptUrl        String?
  receiptName       String?
  receiptUploadedAt DateTime?

  // Datos públicos del video
  videoId         String?
  videoUrl        String?
  title           String?
  thumbnail       String?
  publishedAt     DateTime?
  durationSeconds Int?

  views            BigInt?
  likes            Int?
  comments         Int?
  metricsUpdatedAt DateTime?

  snapshots MetricSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([creatorId])
}

/// Histórico de métricas para graficar la evolución de cada pieza.
model MetricSnapshot {
  id            String      @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  views         BigInt
  likes         Int?
  comments      Int?
  capturedAt    DateTime    @default(now())

  @@index([deliverableId, capturedAt])
}

/// Auditoría de cada revelación de datos bancarios.
model SensitiveAccessLog {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  actor     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([creatorId, createdAt])
}

model Role {
  id String @id

  name        String
  /// Color de la etiqueta, como en Discord.
  color       String   @default("#0046d9")
  /// Llaves de lib/permissions, o ["*"] para el rol de administración.
  permissions String[]
  /// Los roles del sistema no se pueden borrar ni quedarse sin permisos.
  system      Boolean  @default(false)

  users User[]

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model User {
  id String @id

  name         String
  /// Foto de perfil. Por ahora una URL; cuando haya almacenamiento, se sube.
  avatarUrl    String?
  /// Siempre en minúsculas: es la llave de acceso.
  email        String    @unique
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  /// Campañas que lleva y campañas en las que participa.
  managedCampaigns Campaign[]            @relation("CampaignManager")
  createdCampaigns Campaign[]            @relation("CampaignCreatedBy")
  campaignMembers  CampaignMember[]
  creatorLeads     CampaignCreatorLead[]

  createdAt DateTime @default(now())

  @@index([roleId])
  @@index([createdAt])
}

/// Bitácora de movimientos: quién hizo qué y cuándo.
///
/// `SensitiveAccessLog` ya guardaba las revelaciones de datos bancarios y
/// `SessionEvent` las novedades de cada sesión, pero no había forma de mirar
/// la agencia entera y responder «¿quién cerró esta campaña?». Se registra lo
/// que mueve dinero o cambia el estado de algo, no cada clic: un registro que
/// lo guarda todo no lo lee nadie.
model AuditLog {
  id String @id @default(cuid())

  /// Quién. El nombre se copia aquí porque la cuenta puede borrarse después y
  /// «lo hizo el usuario u_3f9» no le sirve a nadie dentro de seis meses.
  actorId   String?
  actorName String

  /// Qué pasó, en llave estable: "campana.borrada", "pago.marcado"…
  action      String
  /// Sobre qué: "campaign", "creator", "session", "deliverable".
  entity      String
  entityId    String
  /// Cómo se llamaba en ese momento, por lo mismo que `actorName`.
  entityLabel String @default("")
  /// Detalle legible, ya redactado. Sale tal cual en la pantalla.
  detail      String @default("")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
}

/// Ajustes de la aplicación. Una sola fila, con id "default".
model Settings {
  id            String  @id @default("default")
  youtubeApiKey String?

  /// Módulos apagados por el desarrollador. Pesan más que cualquier permiso.
  disabledModules String[]

  updatedAt DateTime @updatedAt
}

/**
 * ---------------- Sesiones de entrega (portal externo) ----------------
 */

enum SessionStatus {
  abierta
  cerrada
}

/// Quién entra al portal. La agencia entra por la aplicación, no por código.
enum PortalRole {
  creador
  cliente
  invitado
}

enum SessionItemKind {
  entregable
  guion
  borrador
  referencia
  nota
}

/// Espacio compartido con el creador y el cliente para una colaboración.
model CollabSession {
  id     String        @id
  name   String
  status SessionStatus @default(abierta)
  notes  String        @default("")

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creatorId  String?
  creator    Creator?  @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  /// Si está apagado, nadie de fuera ve métricas aunque tenga acceso.
  showMetrics Boolean @default(true)

  accesses     SessionAccess[]
  items        SessionItem[]
  requirements SessionRequirement[]
  events       SessionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([creatorId])
  @@index([createdAt])
}

/// Un código de acceso al portal. Cifrado, porque la agencia debe reenviarlo.
model SessionAccess {
  id        String        @id
  sessionId String
  session   CollabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role  PortalRole
  label String

  codeEnc  String
  codeHint String

  /// PIN de 4 dígitos que elige quien entra la primera vez. Se guarda hasheado
  /// (scrypt), nunca en claro: a partir de entonces sustituye al código largo.
  pinHash  String?
  pinSetAt DateTime?

  /// Freno a la fuerza bruta sobre este acceso concreto.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  canUpload Boolean @default(true)
  revoked   Boolean @default(false)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([sessionId])
}

/// Material compartido dentro de la sesión. Por ahora siempre un enlace.
model SessionItem {
  id        String        @id
  sessionId String
  session   CollabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  kind  SessionItemKind @default(entregable)
  title String
  url   String?
  notes String          @default("")

  /// Datos del archivo cuando el material se subió en vez de pegarse como
  /// enlace. `url` apunta a Vercel Blob igual que apuntaría a YouTube, así que
  /// sin esto no hay forma de saber que es un archivo nuestro ni de pintar su
  /// nombre y su peso.
  fileName    String?
  fileSize    Int?
  contentType String?

  /// Quién lo subió. La agencia queda registrada con el nombre del usuario.
  authorRole  PortalRole?
  authorLabel String

  /// Material común del que es copia, si se mandó a todas las sesiones.
  masterId String?
  master   CampaignMaterial? @relation(fields: [masterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([masterId])
}

/**
 * ---------------- Avisos del desarrollador ----------------
 */

enum AnnouncementTone {
  info
  ok
  warn
  danger
}

/// Banner que el desarrollador muestra dentro de la aplicación.
model Announcement {
  id      String           @id
  message String
  tone    AnnouncementTone @default(info)
  active  Boolean          @default(true)

  /// Vacío = lo ve todo el mundo. Con roles = solo esos roles.
  roleIds     String[]
  /// Si se puede cerrar, cada quien lo oculta en su navegador.
  dismissible Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt])
}

/**
 * ---------------- Tarifas por red social ----------------
 */

/// Lo que cobra un creador por un tipo de pieza en una plataforma concreta.
/// Reemplaza a las tarifas globales del creador: un short de TikTok no vale lo
/// mismo que uno de YouTube.
/// Catálogo de categorías de creador, editable desde Configuración.
///
/// La ficha del creador sigue guardando la categoría como texto y no como
/// relación: así, borrar una categoría del catálogo no vacía las fichas que la
/// usaban ni obliga a reasignarlas de golpe. El catálogo manda en lo que se
/// ofrece al elegir, no en lo que ya está escrito.
model CreatorCategory {
  id       String @id
  name     String @unique
  /// Orden en el que se ofrece. Lo decide quien edita el catálogo.
  position Int    @default(0)

  createdAt DateTime @default(now())
}

model CreatorRate {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  type     DeliverableType
  amount   Decimal         @default(0) @db.Decimal(12, 2)

  /// Canal secundario al que aplica esta tarifa. Vacío = toda la red.
  ///
  /// Es texto suelto y no una relación porque forma parte de la clave única, y
  /// en Postgres dos filas con la columna en NULL no chocan entre sí: la
  /// restricción no serviría de nada justo en el caso más común, el de la
  /// tarifa general. Con cadena vacía sí protege. Al borrar un canal, sus
  /// tarifas se limpian a mano en `removeCreatorChannel`.
  channelId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, platform, type, channelId])
  @@index([creatorId])
}

/**
 * ---------------- Peticiones a la sesión ----------------
 */

enum RequirementStatus {
  pendiente
  enviado
  cambios
  aprobado
}

/// Lo que la agencia le pide al creador dentro de una sesión: guion, borrador,
/// entregable final… Cada uno se marca como un check que el creador completa.
model SessionRequirement {
  id        String        @id
  sessionId String
  session   CollabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  kind         SessionItemKind @default(entregable)
  title        String
  instructions String          @default("")
  /// Pasos concretos, p. ej. «añadir el enlace en la descripción».
  steps        String[]
  position     Int             @default(0)
  required     Boolean         @default(true)

  /// Para cuándo se espera. Null = sin fecha pactada.
  ///
  /// Vive en la petición y no en la campaña porque lo que tiene fecha es cada
  /// paso —el guion el martes, el borrador el jueves, la publicación el
  /// viernes—, no el trabajo entero. La ve también el creador en su portal.
  dueDate DateTime?

  /// Petición común de la que es copia, si se mandó a todas las sesiones.
  ///
  /// Con relación y en cascada: editar la común cambia todas las copias, y
  /// borrarla las borra. Lo que entrega cada creador y su revisión viven en la
  /// copia, así que siguen siendo de cada uno.
  masterId String?
  master   CampaignRequirement? @relation(fields: [masterId], references: [id], onDelete: Cascade)

  /// Pieza de la campaña que esta petición completa.
  ///
  /// Sin esto, lo que el creador entregaba se quedaba en la sesión y alguien
  /// tenía que copiar el enlace a mano a la campaña; con el enlace puesto,
  /// aprobar la petición rellena el entregable solo. Es texto y no una
  /// relación porque la sesión sobrevive a la campaña —su `campaignId` está en
  /// `SetNull`— y una clave foránea la arrastraría al borrarla.
  deliverableId String?

  status      RequirementStatus @default(pendiente)
  /// Lo que entrega el creador: un enlace por ahora.
  url         String?
  notes       String            @default("")
  submittedAt DateTime?

  reviewedAt  DateTime?
  reviewNotes String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, position])
  @@index([masterId])
}

enum SessionEventKind {
  entrega
  aprobacion
  cambios
  pago
  nota
}

/// Novedades de una sesión, para que cada lado vea qué pasó sin recargar a ciegas.
model SessionEvent {
  id        String        @id @default(cuid())
  sessionId String
  session   CollabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  kind       SessionEventKind
  message    String
  /// Quién lo provocó: el nombre del acceso o del usuario de la agencia.
  actorLabel String

  /// Pendiente de leer por cada lado, para el punto de aviso.
  unreadAgency  Boolean @default(true)
  unreadCreator Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

/// Intentos fallidos en la puerta del portal. Sirve para frenar la fuerza bruta
/// sin guardar la dirección IP en claro.
model PortalAttempt {
  id        String @id @default(cuid())
  sessionId String
  ipHash    String

  createdAt DateTime @default(now())

  @@index([sessionId, ipHash, createdAt])
  @@index([createdAt])
}

/**
 * ---------------- Notas y documentos ----------------
 */

/// Carpeta de proyecto. Se anidan entre sí para agrupar como convenga:
/// por cliente, por campaña o por temporada.
model Folder {
  id    String @id
  name  String
  /// Icono de Lucide y color de la etiqueta, como en los roles.
  icon  String @default("folder")
  color String @default("#4f7cff")

  parentId String?
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")

  /// Orden manual dentro de su carpeta madre.
  position Int @default(0)

  docs Doc[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, position])
}

/// Una nota. El contenido vive dos veces a propósito:
///
///  - `content` es el documento de Tiptap, sin pérdida, y es lo que edita.
///  - `plainText` es el mismo texto aplanado al guardar, y es lo único
///    que Postgres sabe buscar: un árbol de ProseMirror no se puede indexar.
model Doc {
  id    String @id
  title String @default("Sin título")

  content   Json?
  plainText String @default("")

  /// Resumen corto para la lista, derivado del texto al guardar.
  excerpt String @default("")

  icon String @default("file-text")

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  /// Quién la creó. Null si esa cuenta se elimina: la nota no se pierde.
  createdById String?
  updatedById String?

  archived Boolean @default(false)
  /// Fijada arriba en la lista de su carpeta.
  pinned   Boolean @default(false)

  links DocLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId, updatedAt])
  @@index([archived, updatedAt])
}

/// Enlace de una nota con algo de la agencia.
///
/// Va en tabla aparte para que una misma nota pueda colgar de una campaña y
/// de dos creadores a la vez, y para poder listarla desde cualquiera de esas
/// fichas sin duplicar el contenido.
model DocLink {
  id    String @id
  docId String
  doc   Doc    @relation(fields: [docId], references: [id], onDelete: Cascade)

  campaignId String?
  creatorId  String?
  companyId  String?

  createdAt DateTime @default(now())

  @@index([docId])
  @@index([campaignId])
  @@index([creatorId])
  @@index([companyId])
}

/**
 * ---------------- Métricas personalizadas ----------------
 */

enum MetricScope {
  campana
  entregable
}

/// Cómo se presenta el resultado de una fórmula.
enum MetricFormat {
  numero
  porcentaje
  moneda
}

/// Métrica que define el equipo con una fórmula sobre los datos de la campaña.
/// La expresión se evalúa con `lib/formulas.ts`, nunca como JavaScript.
model MetricFormula {
  id         String       @id
  name       String
  /// Expresión aritmética: «interacciones / vistas * 100».
  expression String
  scope      MetricScope  @default(campana)
  format     MetricFormat @default(numero)
  /// Decimales a mostrar.
  decimals   Int          @default(2)
  /// Texto corto bajo la cifra, para recordar qué mide.
  hint       String       @default("")

  /// Fijada en la banda superior de la campaña.
  featured Boolean @default(false)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, position])
}

/// Tipo de pieza que se inventa la agencia: «Unboxing», «Podcast», «Mención en
/// la newsletter».
///
/// El enum `DeliverableType` se queda como la familia de la que cuelga cada
/// uno, y esa familia es la que decide qué tarifa del creador se propone. Se
/// hizo así en vez de abrir el enum porque las tarifas, el gráfico de vistas y
/// los informes están escritos contra esos cinco formatos: un catálogo abierto
/// que no cuelgue de ninguno deja piezas sin precio de partida y sin sitio en
/// el gráfico.
model DeliverableKind {
  id       String          @id
  name     String          @unique
  /// De qué formato de fábrica hereda la tarifa.
  baseType DeliverableType @default(video)
  /// Orden en el que se ofrece. Lo decide quien edita el catálogo.
  position Int             @default(0)

  createdAt DateTime @default(now())
}

/// Quién lleva a un creador concreto dentro de una campaña.
///
/// `CampaignMember` dice quién anda en la campaña entera; esto dice quién
/// responde por este influencer, que es la pregunta que se hace el equipo
/// cuando algo se atrasa. Sin filas, se entiende que responde el manager de la
/// campaña: es lo que ya pasaba antes de que esto existiera y evita tener que
/// rellenar la asignación creador a creador para que la pantalla diga algo.
model CampaignCreatorLead {
  id         String   @id
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, creatorId, userId])
  @@index([campaignId, creatorId])
  @@index([userId])
}

/// Petición que la agencia manda a todas las sesiones de una campaña.
///
/// Es el original de la sesión maestra: se copia a cada sesión que ya existe y
/// a las que se abran después al contratar a alguien más, que es lo que evita
/// tener que ir sesión por sesión repitiendo lo mismo. Las copias son filas
/// normales de `SessionRequirement`, porque cada creador entrega y se le revisa
/// por separado; solo el enunciado es común.
model CampaignRequirement {
  id         String   @id
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  kind         SessionItemKind @default(entregable)
  title        String
  instructions String          @default("")
  steps        String[]
  required     Boolean         @default(true)
  dueDate      DateTime?
  position     Int             @default(0)

  copies SessionRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, position])
}

/// Material que la agencia comparte con todas las sesiones de una campaña: el
/// brief, la guía de marca, el logo. Se copia igual que las peticiones comunes.
model CampaignMaterial {
  id         String   @id
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  kind        SessionItemKind @default(referencia)
  title       String
  url         String?
  notes       String          @default("")
  fileName    String?
  fileSize    Int?
  contentType String?
  authorLabel String

  copies SessionItem[]

  createdAt DateTime @default(now())

  @@index([campaignId, createdAt])
}

/// Un cobro al cliente por una campaña.
///
/// Es el otro lado del dinero: el pago al creador ya vivía en cada pieza, pero
/// lo que la empresa le paga a la agencia no se apuntaba en ningún sitio, así
/// que «¿ya nos pagaron?» solo se contestaba mirando el banco. Son filas y no un
/// estado porque el cliente no siempre paga de una vez: un anticipo y el resto
/// al cerrar son dos cobros.
model CampaignPayment {
  id         String   @id
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  amount Decimal  @db.Decimal(12, 2)
  paidAt DateTime
  notes  String   @default("")

  /// Comprobante de la transferencia del cliente, en Vercel Blob.
  receiptUrl  String?
  receiptName String?

  /// Quién lo apuntó. Texto y no relación: la cuenta puede borrarse después.
  createdByName String @default("")

  createdAt DateTime @default(now())

  @@index([campaignId, paidAt])
}

/// Dato de contacto de nombre libre de un cliente: Discord, WeChat, Telegram…
/// Lo mismo que ya tenían los creadores: cada cliente se habla por un sitio y
/// no cabe en los campos fijos de correo y teléfono.
model CompanyContactField {
  id        String  @id
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  label    String
  value    String @default("")
  position Int    @default(0)

  createdAt DateTime @default(now())

  @@index([companyId])
}
