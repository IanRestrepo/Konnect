// Esquema de Konnect — Postgres (Neon).
// Refleja los tipos de `lib/types.ts`; `lib/store.ts` es la única capa que lo consulta.
// Los campos bancarios se guardan cifrados (AES-256-GCM) mediante lib/crypto.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CreatorStatus {
  activo
  pausado
  prospecto
  archivado
}

enum CompanyStatus {
  activo
  prospecto
  inactivo
}

/// `finalizada` es que se cumplió; `cancelada`, que se cayó. Las dos cierran la
/// campaña, pero mezclarlas falsea los informes: lo cancelado no se facturó.
enum CampaignStatus {
  borrador
  activa
  pausada
  finalizada
  cancelada
}

enum CampaignObjective {
  awareness
  trafico
  conversiones
  lanzamiento
}

/// Qué se le encarga al creador. El nombre que ve el equipo depende también de
/// la red: un `short` es un Reel en Instagram y un Short en YouTube.
enum DeliverableType {
  video
  short
  integracion
  /// Emisión en vivo: stream patrocinado o mención durante el directo.
  directo
  /// Publicación estática: carrusel, foto o hilo.
  post
}

enum DeliverableStatus {
  pendiente
  en_revision
  publicado
  cancelado
}

/// Estado del pago de una pieza. Lo ve la agencia y también el creador.
enum PaymentStatus {
  pendiente
  aprobado
  pagado
}

enum PaymentMethod {
  transferencia
  paypal
  wise
  binance
  deel
  efectivo
}

enum SocialPlatform {
  youtube
  instagram
  tiktok
  x
  twitch
  kick
  discord
  roblox
  web
}

model Creator {
  id     String @id
  name   String
  handle String

  /// Dónde vive principalmente. No todos los creadores son de YouTube.
  mainPlatform SocialPlatform @default(youtube)

  /// Solo para canales de YouTube; vacío en el resto de plataformas.
  channelId  String?
  channelUrl String?
  avatarUrl  String?
  country    String        @default("")
  category   String
  status     CreatorStatus @default(prospecto)

  email String @default("")
  phone String @default("")

  // Métricas públicas del canal (YouTube Data API)
  subscribers      Int       @default(0)
  totalViews       BigInt    @default(0)
  videoCount       Int       @default(0)
  metricsUpdatedAt DateTime?

  currency        String          @default("USD")
  rateVideo       Decimal         @default(0) @db.Decimal(12, 2)
  rateShort       Decimal         @default(0) @db.Decimal(12, 2)
  rateIntegration Decimal         @default(0) @db.Decimal(12, 2)
  paymentMethods  PaymentMethod[]

  // Confidencial: cifrado en reposo. Los *Last4 permiten la vista censurada.
  bankHolder       String?
  bankName         String?
  bankAccountEnc   String?
  bankAccountLast4 String?
  bankRoutingEnc   String?
  bankRoutingLast4 String?
  taxIdEnc         String?
  taxIdLast4       String?
  paypalEmailEnc   String?
  bankNotesEnc     String?

  notes String @default("")

  rates          CreatorRate[]
  contacts       CreatorContact[]
  contactFields  CreatorContactField[]
  bankAccounts   CreatorBankAccount[]
  channels       CreatorChannel[]
  socials        SocialLink[]
  deliverables   Deliverable[]
  accessLogs     SensitiveAccessLog[]
  sessions       CollabSession[]
  apiConnections CreatorApiConnection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

/// Persona con la que se habla de un creador: él mismo, su mánager, su agencia.
/// Aparte de `Contact`, que cuelga de una empresa.
model CreatorContact {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  name    String
  /// Mánager, representante, editor… quién es respecto al creador.
  role    String  @default("")
  email   String  @default("")
  phone   String  @default("")
  /// El principal es con quien se habla por defecto.
  primary Boolean @default(false)
  notes   String  @default("")

  createdAt DateTime @default(now())

  @@index([creatorId])
}

/// Dato de contacto que no cabe en los campos fijos de la ficha: Discord,
/// Telegram, el correo del mánager… La agencia le pone el nombre que quiera.
///
/// Es una tabla y no una columna porque cada creador usa unos distintos y la
/// lista crece: fijar columnas obligaría a migrar cada vez que aparece una red
/// nueva por la que se le escribe.
model CreatorContactField {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  /// Cómo lo llama la agencia: "Discord", "Telegram", "Correo del mánager".
  label String
  value String @default("")
  /// Orden en la ficha, tal y como lo dejó quien editó.
  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([creatorId])
}

/// Una forma concreta de pagarle a un creador: su cuenta de banco, su PayPal,
/// su Binance… Un creador puede tener varias y cobrar por la que convenga.
///
/// Los campos que sirven para mover dinero van cifrados igual que los de la
/// ficha; los `*Last4` permiten la vista censurada sin descifrar nada.
model CreatorBankAccount {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  method PaymentMethod
  /// Cómo la llama la agencia: "Bancolombia principal", "PayPal personal".
  label  String @default("")
  holder String @default("")
  /// Solo tiene sentido en transferencia.
  bankName String @default("")

  /// Lo que hace falta para pagar: número de cuenta, correo o billetera.
  referenceEnc   String?
  referenceLast4 String?
  /// SWIFT, routing o red de la billetera.
  routingEnc   String?
  routingLast4 String?
  notesEnc     String?

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}

/// Canal adicional de un creador: secundario, de shorts, de clips…
model CreatorChannel {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  label      String
  channelId  String
  channelUrl String
  handle     String
  avatarUrl  String?

  subscribers      Int       @default(0)
  totalViews       BigInt    @default(0)
  videoCount       Int       @default(0)
  metricsUpdatedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([creatorId, channelId])
  @@index([creatorId])
}

/// Perfil del creador en una plataforma, con sus propias métricas.
model SocialLink {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  handle   String
  url      String

  avatarUrl String?

  /// Seguidores, suscriptores o como los llame cada plataforma.
  followers        Int       @default(0)
  totalViews       BigInt    @default(0)
  contentCount     Int       @default(0)
  metricsUpdatedAt DateTime?

  createdAt DateTime @default(now())

  @@index([creatorId])
}

/// Credencial del creador para leer SU PROPIA analítica en cada plataforma
/// (YouTube Analytics API y, más adelante, Instagram y TikTok).
///
/// El secreto se guarda cifrado en reposo (AES-256-GCM, lib/crypto.ts) y nunca
/// se devuelve al cliente: la ficha sólo muestra los últimos 4 caracteres.
/// Por ahora la única plataforma funcional es `youtube`; el modelo ya admite el
/// resto para no volver a migrar cuando se activen.
model CreatorApiConnection {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform    SocialPlatform
  secretEnc   String
  secretLast4 String         @default("")
  /// Id externo asociado a la credencial (channelId de YouTube, etc.).
  externalId  String         @default("")
  status      String         @default("conectada")

  connectedAt DateTime  @default(now())
  checkedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, platform])
  @@index([creatorId])
}

model Company {
  id       String  @id
  name     String
  industry String
  website  String?

  // Atajo al contacto principal; se mantiene sincronizado con `contacts`.
  contactName String @default("")
  contactRole String @default("")
  email       String @default("")
  phone       String @default("")

  instagram String?
  tiktok    String?
  youtube   String?
  linkedin  String?

  status CompanyStatus @default(prospecto)
  notes  String        @default("")

  contacts  Contact[]
  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Persona de contacto en una empresa. Puede haber varias.
model Contact {
  id        String  @id
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name    String
  role    String  @default("")
  email   String  @default("")
  phone   String  @default("")
  primary Boolean @default(false)
  notes   String  @default("")

  createdAt DateTime @default(now())

  @@index([companyId])
}

model Campaign {
  id        String            @id
  name      String
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status    CampaignStatus    @default(borrador)
  objective CampaignObjective @default(awareness)
  currency  String            @default("USD")
  /// Opcional, al estilo CBO: si se define, es un tope de referencia. El precio
  /// real de la campaña es la suma de lo pactado con cada creador (ABO).
  budget    Decimal?          @db.Decimal(12, 2)
  /// Margen por defecto de la agencia, en % sobre el pago al creador.
  agencyFee Decimal?          @db.Decimal(5, 2)
  startDate DateTime
  endDate   DateTime?
  notes     String            @default("")

  deliverables Deliverable[]
  sessions     CollabSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model Deliverable {
  id         String            @id
  campaignId String
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    Creator           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  type       DeliverableType
  status     DeliverableStatus @default(pendiente)

  /// Red social en la que se publica. Determina qué tarifa del creador aplica.
  platform SocialPlatform @default(youtube)

  /// Canal secundario en el que se publica, si se pactó uno concreto. Vacío =
  /// su canal principal. Elige qué tarifa del creador se aplicó.
  channelId String @default("")

  /// Lo que paga el cliente por esta pieza. Es el número base del que salen
  /// la comisión de la agencia y el pago al creador.
  clientPrice Decimal @default(0) @db.Decimal(12, 2)

  /// Comisión de la agencia, en % del cobro al cliente. Null = hereda el de la
  /// campaña. Se ignora si hay comisión fija.
  commissionPct   Decimal? @db.Decimal(5, 2)
  /// Comisión en cantidad fija, cuando no se pacta por porcentaje.
  commissionFixed Decimal? @db.Decimal(12, 2)

  /// Lo que recibe el creador: cobro al cliente menos comisión. Se guarda ya
  /// calculado para que los informes no dependan de rehacer la cuenta.
  agreedFee Decimal @default(0) @db.Decimal(12, 2)

  paymentStatus PaymentStatus @default(pendiente)
  paidAt        DateTime?

  /// Comprobante del pago al creador: la transferencia, el recibo de PayPal…
  /// Vive en Vercel Blob; aquí solo el enlace y con qué nombre se subió.
  receiptUrl      String?
  receiptName     String?
  receiptUploadedAt DateTime?

  // Datos públicos del video
  videoId         String?
  videoUrl        String?
  title           String?
  thumbnail       String?
  publishedAt     DateTime?
  durationSeconds Int?

  views            BigInt?
  likes            Int?
  comments         Int?
  metricsUpdatedAt DateTime?

  snapshots MetricSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([creatorId])
}

/// Histórico de métricas para graficar la evolución de cada pieza.
model MetricSnapshot {
  id            String      @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  views         BigInt
  likes         Int?
  comments      Int?
  capturedAt    DateTime    @default(now())

  @@index([deliverableId, capturedAt])
}

/// Auditoría de cada revelación de datos bancarios.
model SensitiveAccessLog {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  actor     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([creatorId, createdAt])
}

model Role {
  id String @id

  name        String
  /// Color de la etiqueta, como en Discord.
  color       String   @default("#0046d9")
  /// Llaves de lib/permissions, o ["*"] para el rol de administración.
  permissions String[]
  /// Los roles del sistema no se pueden borrar ni quedarse sin permisos.
  system      Boolean  @default(false)

  users User[]

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model User {
  id String @id

  name         String
  /// Foto de perfil. Por ahora una URL; cuando haya almacenamiento, se sube.
  avatarUrl    String?
  /// Siempre en minúsculas: es la llave de acceso.
  email        String    @unique
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())

  @@index([roleId])
  @@index([createdAt])
}

/// Ajustes de la aplicación. Una sola fila, con id "default".
model Settings {
  id            String  @id @default("default")
  youtubeApiKey String?

  /// Módulos apagados por el desarrollador. Pesan más que cualquier permiso.
  disabledModules String[]

  updatedAt DateTime @updatedAt
}

/**
 * ---------------- Sesiones de entrega (portal externo) ----------------
 */

enum SessionStatus {
  abierta
  cerrada
}

/// Quién entra al portal. La agencia entra por la aplicación, no por código.
enum PortalRole {
  creador
  cliente
  invitado
}

enum SessionItemKind {
  entregable
  guion
  borrador
  referencia
  nota
}

/// Espacio compartido con el creador y el cliente para una colaboración.
model CollabSession {
  id     String        @id
  name   String
  status SessionStatus @default(abierta)
  notes  String        @default("")

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creatorId  String?
  creator    Creator?  @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  /// Si está apagado, nadie de fuera ve métricas aunque tenga acceso.
  showMetrics Boolean @default(true)

  accesses     SessionAccess[]
  items        SessionItem[]
  requirements SessionRequirement[]
  events       SessionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([creatorId])
  @@index([createdAt])
}

/// Un código de acceso al portal. Cifrado, porque la agencia debe reenviarlo.
model SessionAccess {
  id        String        @id
  sessionId String
  session   CollabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role  PortalRole
  label String

  codeEnc  String
  codeHint String

  /// PIN de 4 dígitos que elige quien entra la primera vez. Se guarda hasheado
  /// (scrypt), nunca en claro: a partir de entonces sustituye al código largo.
  pinHash  String?
  pinSetAt DateTime?

  /// Freno a la fuerza bruta sobre este acceso concreto.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  canUpload Boolean @default(true)
  revoked   Boolean @default(false)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([sessionId])
}

/// Material compartido dentro de la sesión. Por ahora siempre un enlace.
model SessionItem {
  id        String        @id
  sessionId String
  session   CollabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  kind  SessionItemKind @default(entregable)
  title String
  url   String?
  notes String          @default("")

  /// Datos del archivo cuando el material se subió en vez de pegarse como
  /// enlace. `url` apunta a Vercel Blob igual que apuntaría a YouTube, así que
  /// sin esto no hay forma de saber que es un archivo nuestro ni de pintar su
  /// nombre y su peso.
  fileName    String?
  fileSize    Int?
  contentType String?

  /// Quién lo subió. La agencia queda registrada con el nombre del usuario.
  authorRole  PortalRole?
  authorLabel String

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

/**
 * ---------------- Avisos del desarrollador ----------------
 */

enum AnnouncementTone {
  info
  ok
  warn
  danger
}

/// Banner que el desarrollador muestra dentro de la aplicación.
model Announcement {
  id      String           @id
  message String
  tone    AnnouncementTone @default(info)
  active  Boolean          @default(true)

  /// Vacío = lo ve todo el mundo. Con roles = solo esos roles.
  roleIds     String[]
  /// Si se puede cerrar, cada quien lo oculta en su navegador.
  dismissible Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt])
}

/**
 * ---------------- Tarifas por red social ----------------
 */

/// Lo que cobra un creador por un tipo de pieza en una plataforma concreta.
/// Reemplaza a las tarifas globales del creador: un short de TikTok no vale lo
/// mismo que uno de YouTube.
/// Catálogo de categorías de creador, editable desde Configuración.
///
/// La ficha del creador sigue guardando la categoría como texto y no como
/// relación: así, borrar una categoría del catálogo no vacía las fichas que la
/// usaban ni obliga a reasignarlas de golpe. El catálogo manda en lo que se
/// ofrece al elegir, no en lo que ya está escrito.
model CreatorCategory {
  id   String @id
  name String @unique
  /// Orden en el que se ofrece. Lo decide quien edita el catálogo.
  position Int @default(0)

  createdAt DateTime @default(now())
}

model CreatorRate {
  id        String  @id
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  type     DeliverableType
  amount   Decimal         @default(0) @db.Decimal(12, 2)

  /// Canal secundario al que aplica esta tarifa. Vacío = toda la red.
  ///
  /// Es texto suelto y no una relación porque forma parte de la clave única, y
  /// en Postgres dos filas con la columna en NULL no chocan entre sí: la
  /// restricción no serviría de nada justo en el caso más común, el de la
  /// tarifa general. Con cadena vacía sí protege. Al borrar un canal, sus
  /// tarifas se limpian a mano en `removeCreatorChannel`.
  channelId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, platform, type, channelId])
  @@index([creatorId])
}

/**
 * ---------------- Peticiones a la sesión ----------------
 */

enum RequirementStatus {
  pendiente
  enviado
  cambios
  aprobado
}

/// Lo que la agencia le pide al creador dentro de una sesión: guion, borrador,
/// entregable final… Cada uno se marca como un check que el creador completa.
model SessionRequirement {
  id        String        @id
  sessionId String
  session   CollabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  kind         SessionItemKind @default(entregable)
  title        String
  instructions String          @default("")
  /// Pasos concretos, p. ej. «añadir el enlace en la descripción».
  steps        String[]
  position     Int             @default(0)
  required     Boolean         @default(true)

  status      RequirementStatus @default(pendiente)
  /// Lo que entrega el creador: un enlace por ahora.
  url         String?
  notes       String            @default("")
  submittedAt DateTime?

  reviewedAt  DateTime?
  reviewNotes String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, position])
}

enum SessionEventKind {
  entrega
  aprobacion
  cambios
  pago
  nota
}

/// Novedades de una sesión, para que cada lado vea qué pasó sin recargar a ciegas.
model SessionEvent {
  id        String        @id @default(cuid())
  sessionId String
  session   CollabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  kind       SessionEventKind
  message    String
  /// Quién lo provocó: el nombre del acceso o del usuario de la agencia.
  actorLabel String

  /// Pendiente de leer por cada lado, para el punto de aviso.
  unreadAgency  Boolean @default(true)
  unreadCreator Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

/// Intentos fallidos en la puerta del portal. Sirve para frenar la fuerza bruta
/// sin guardar la dirección IP en claro.
model PortalAttempt {
  id        String @id @default(cuid())
  sessionId String
  ipHash    String

  createdAt DateTime @default(now())

  @@index([sessionId, ipHash, createdAt])
  @@index([createdAt])
}

/**
 * ---------------- Notas y documentos ----------------
 */

/// Carpeta de proyecto. Se anidan entre sí para agrupar como convenga:
/// por cliente, por campaña o por temporada.
model Folder {
  id    String @id
  name  String
  /// Icono de Lucide y color de la etiqueta, como en los roles.
  icon  String @default("folder")
  color String @default("#4f7cff")

  parentId String?
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")

  /// Orden manual dentro de su carpeta madre.
  position Int @default(0)

  docs Doc[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, position])
}

/// Una nota. El contenido vive dos veces a propósito:
///
///  - `content` es el documento de Tiptap, sin pérdida, y es lo que edita.
///  - `plainText` es el mismo texto aplanado al guardar, y es lo único
///    que Postgres sabe buscar: un árbol de ProseMirror no se puede indexar.
model Doc {
  id    String @id
  title String @default("Sin título")

  content   Json?
  plainText String @default("")

  /// Resumen corto para la lista, derivado del texto al guardar.
  excerpt String @default("")

  icon String @default("file-text")

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  /// Quién la creó. Null si esa cuenta se elimina: la nota no se pierde.
  createdById String?
  updatedById String?

  archived Boolean @default(false)
  /// Fijada arriba en la lista de su carpeta.
  pinned   Boolean @default(false)

  links DocLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId, updatedAt])
  @@index([archived, updatedAt])
}

/// Enlace de una nota con algo de la agencia.
///
/// Va en tabla aparte para que una misma nota pueda colgar de una campaña y
/// de dos creadores a la vez, y para poder listarla desde cualquiera de esas
/// fichas sin duplicar el contenido.
model DocLink {
  id    String @id
  docId String
  doc   Doc    @relation(fields: [docId], references: [id], onDelete: Cascade)

  campaignId String?
  creatorId  String?
  companyId  String?

  createdAt DateTime @default(now())

  @@index([docId])
  @@index([campaignId])
  @@index([creatorId])
  @@index([companyId])
}

/**
 * ---------------- Métricas personalizadas ----------------
 */

enum MetricScope {
  campana
  entregable
}

/// Cómo se presenta el resultado de una fórmula.
enum MetricFormat {
  numero
  porcentaje
  moneda
}

/// Métrica que define el equipo con una fórmula sobre los datos de la campaña.
/// La expresión se evalúa con `lib/formulas.ts`, nunca como JavaScript.
model MetricFormula {
  id         String       @id
  name       String
  /// Expresión aritmética: «interacciones / vistas * 100».
  expression String
  scope      MetricScope  @default(campana)
  format     MetricFormat @default(numero)
  /// Decimales a mostrar.
  decimals   Int          @default(2)
  /// Texto corto bajo la cifra, para recordar qué mide.
  hint       String       @default("")

  /// Fijada en la banda superior de la campaña.
  featured Boolean @default(false)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, position])
}
